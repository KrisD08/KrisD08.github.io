# .env.example — LAB-02
#
# Este archivo SÍ se commitea: es la plantilla, sin secretos reales.
# Cópialo a .env (que NUNCA se commitea) antes de levantar el proyecto:
#   cp .env.example .env
#
# En Codespaces esto lo hace solo el devcontainer (ver .devcontainer/devcontainer.json),
# por eso el B3 funciona aunque .env nunca esté en el repositorio.

# --- Postgres (los lee la imagen oficial de "db") ---
POSTGRES_DB=libro
POSTGRES_USER=app
POSTGRES_PASSWORD=cambia-esta-clave-en-tu-env-local

# --- API (deben coincidir con los valores de arriba) ---
PORT=3000
DB_HOST=db
DB_PORT=5432
DB_NAME=libro
DB_USER=app
DB_PASSWORD=cambia-esta-clave-en-tu-env-local
